# Copy this file to `.env.local` and fill in real values.
# Public site works WITHOUT these — they are only needed once the
# Supabase-backed admin (phase 2) is wired up.

# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://emddbgiatagplxsehuyo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Not needed for the owner-authenticated dashboard (RLS + the logged-in
# session cover all writes). Only add if a server-side admin task ever needs it.
# NEVER expose to the browser or commit.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
